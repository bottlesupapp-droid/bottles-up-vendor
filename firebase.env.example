# Firebase Configuration for Bottles Up Vendor
# Copy this file to firebase.env and fill in your actual values
# DO NOT commit firebase.env to version control

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_REGION=us-central1
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Development Environment
NODE_ENV=development
FLUTTER_ENV=development

# Firebase Emulator Ports (for local development)
FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_FIRESTORE_EMULATOR_PORT=8080
FIREBASE_STORAGE_EMULATOR_PORT=9199
FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# App Configuration
APP_NAME=Bottles Up Vendor
APP_VERSION=1.0.0
DEBUG_MODE=true
