{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Run (with env.json)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "Flutter: Run (iOS Device)",
      "request": "launch",
      "type": "dart",
      "deviceId": "ios",
      "toolArgs": [
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "Flutter: Run (Android Device)",
      "request": "launch",
      "type": "dart",
      "deviceId": "android",
      "toolArgs": [
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "Flutter: Profile Mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "Flutter: Release Mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define-from-file=env.json"
      ]
    }
  ]
}
